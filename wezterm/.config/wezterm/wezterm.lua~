-- Pull in the WezTerm API
local wezterm = require 'wezterm'


-- This table will hold the configuration
local config = {}

-- Use config_builder if available (recommended for newer WezTerm versions)
if wezterm.config_builder then
  config = wezterm.config_builder()
end

-- Set the color scheme to Catppuccin Frappe
config.color_scheme = 'Catppuccin Frappe'

-- Configure the font to JetBrains Mono Nerd Font
config.font = wezterm.font 'JetBrainsMono Nerd Font'

-- Optional: Set font size (adjust as needed)
config.font_size = 14
0

-- Optional: Add fallback fonts in case JetBrains Mono Nerd Font isn't available
config.font = wezterm.font_with_fallback {
  'JetBrainsMono Nerd Font',
  'Nerd Font Symbols', -- Included with WezTerm by default
  'Noto Color Emoji',  -- For emoji support
}

-- Optional: Additional customizations
config.enable_tab_bar = true           -- Show the tab bar
config.hide_tab_bar_if_only_one_tab = true -- Hide it when only one tab is open
config.window_padding = {
  left = 2,
  right = 2,
  top = 2,
  bottom = 0,
}


-- Return the configuration to WezTerm
return config
